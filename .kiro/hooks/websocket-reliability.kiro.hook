{
  "enabled": true,
  "name": "WebSocket Reliability",
  "description": "Reviews WebSocket and real-time communication code for reliability and scalability",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*websocket*.js",
      "*websocket*.ts",
      "*socket*.js",
      "*socket*.ts",
      "*realtime*.js",
      "*realtime*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "WebSocket code was modified. Analyze for: 1) Reconnection logic with exponential backoff, 2) Heartbeat/ping-pong for connection health, 3) Message queuing during disconnection, 4) Authentication and authorization, 5) Rate limiting and backpressure, 6) Proper cleanup on disconnect, 7) Scalability with multiple server instances. Suggest reliability improvements."
  }
}