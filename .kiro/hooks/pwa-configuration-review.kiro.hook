{
  "enabled": true,
  "name": "PWA Configuration Review",
  "description": "Reviews progressive web app configuration",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "manifest.json",
      "*service-worker*.js",
      "*sw*.js",
      "*pwa*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "PWA configuration was modified. Check for: 1) Manifest completeness (icons, theme, display), 2) Service worker caching strategy, 3) Offline functionality, 4) Update notification strategy, 5) Install prompt handling, 6) Background sync, 7) Push notification setup. Suggest PWA improvements."
  }
}