{
  "enabled": true,
  "name": "Privacy Compliance Review",
  "description": "Analyzes data privacy and GDPR compliance in code",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*privacy*.js",
      "*privacy*.ts",
      "*gdpr*.js",
      "*gdpr*.ts",
      "*consent*.js",
      "*consent*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Privacy-related code was modified. Review for: 1) User consent tracking and enforcement, 2) Right to deletion implementation, 3) Data export functionality, 4) PII anonymization and pseudonymization, 5) Cookie consent management, 6) Third-party data sharing controls, 7) Privacy policy compliance. Flag compliance gaps."
  }
}