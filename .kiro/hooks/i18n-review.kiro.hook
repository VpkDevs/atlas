{
  "enabled": true,
  "name": "i18n Review",
  "description": "Reviews internationalization and localization code for completeness and best practices",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*i18n*.js",
      "*i18n*.ts",
      "*locale*.js",
      "*locale*.ts",
      "*translation*.js",
      "*translation*.ts",
      "*.po",
      "*.pot"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Internationalization code was modified. Check for: 1) Missing translations or fallback handling, 2) Pluralization rules for different languages, 3) Date, time, and number formatting, 4) RTL language support, 5) String concatenation vs proper interpolation, 6) Context for translators, 7) Currency and timezone handling. Suggest improvements for global users."
  }
}