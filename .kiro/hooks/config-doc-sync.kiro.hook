{
  "enabled": true,
  "name": "Config Documentation Sync",
  "description": "Automatically generates or updates documentation when configuration files are modified to keep docs in sync with changes",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.json",
      "*.yaml",
      "*.yml",
      "*.toml",
      "*.ini",
      "*.env.example",
      ".env.template"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A configuration file was modified. Review the changes and update any related documentation (README.md, setup guides, or inline comments) to reflect the new configuration. Explain what changed and why it matters for users or developers."
  }
}