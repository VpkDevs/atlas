{
  "enabled": true,
  "name": "OAuth Security Review",
  "description": "Analyzes OAuth and SSO implementations for security",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*oauth*.js",
      "*oauth*.ts",
      "*sso*.js",
      "*sso*.ts",
      "*saml*.js",
      "*oidc*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "OAuth/SSO code was modified. Review for: 1) PKCE for public clients, 2) State parameter for CSRF protection, 3) Token storage security, 4) Scope validation, 5) Redirect URI validation, 6) Token refresh handling, 7) Logout and token revocation. Flag security vulnerabilities."
  }
}