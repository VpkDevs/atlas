{
  "enabled": true,
  "name": "Migration Safety Check",
  "description": "Analyzes database migration files for data safety, rollback strategies, and potential issues",
  "version": "1",
  "when": {
    "type": "fileCreated",
    "patterns": [
      "*migration*.sql",
      "*migration*.js",
      "*migration*.ts",
      "*migration*.py",
      "migrations/*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A database migration was created. Review for: 1) Data loss risks (DROP, TRUNCATE without backups), 2) Rollback/down migration strategy, 3) Impact on production data and downtime, 4) Index creation on large tables (should be CONCURRENT), 5) Foreign key constraints and cascades, 6) Default values for new NOT NULL columns. Flag any dangerous operations."
  }
}