{
  "enabled": true,
  "name": "Backup Strategy Review",
  "description": "Analyzes backup and disaster recovery code",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*backup*.js",
      "*backup*.ts",
      "*backup*.py",
      "*restore*.js",
      "*restore*.py"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Backup/restore code was modified. Review for: 1) Backup frequency and retention policy, 2) Backup verification and testing, 3) Encryption at rest and in transit, 4) Point-in-time recovery capability, 5) Restore procedure documentation, 6) Backup monitoring and alerting, 7) Geographic redundancy. Suggest improvements for disaster recovery."
  }
}