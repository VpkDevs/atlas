{
  "enabled": true,
  "name": "SEO Optimization",
  "description": "Reviews sitemap and SEO configuration",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "sitemap.xml",
      "robots.txt",
      "*seo*.js",
      "*seo*.ts",
      "*meta*.js",
      "*meta*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "SEO configuration was modified. Check for: 1) Sitemap completeness and freshness, 2) Robots.txt correctness, 3) Meta tags (title, description, OG tags), 4) Canonical URLs, 5) Structured data (JSON-LD), 6) Mobile-friendliness, 7) Page speed considerations. Suggest SEO improvements."
  }
}