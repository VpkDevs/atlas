{
  "enabled": true,
  "name": "API Versioning Review",
  "description": "Reviews API versioning strategy and backward compatibility",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*v1/*",
      "*v2/*",
      "*version*.js",
      "*version*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "API versioning code was modified. Analyze for: 1) Backward compatibility with older versions, 2) Deprecation warnings and sunset dates, 3) Version negotiation strategy (URL, header, query param), 4) Shared code vs duplicated logic, 5) Migration guides for clients, 6) Version-specific tests, 7) Documentation for each version. Suggest versioning improvements."
  }
}