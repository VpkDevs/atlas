{
  "enabled": true,
  "name": "Mobile App Review",
  "description": "Analyzes mobile app code for platform-specific issues, performance, and UX best practices",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.swift",
      "*.kt",
      "*.java",
      "*.dart",
      "*Screen*.tsx",
      "*Screen*.jsx"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Mobile app code was modified. Check for: 1) Memory leaks and retain cycles, 2) Battery-draining operations (location, background tasks), 3) Network efficiency (caching, compression), 4) Offline functionality, 5) Platform-specific UI guidelines (iOS HIG, Material Design), 6) Accessibility (VoiceOver, TalkBack), 7) App size optimization. Suggest improvements."
  }
}