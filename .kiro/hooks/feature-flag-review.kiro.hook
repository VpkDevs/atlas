{
  "enabled": true,
  "name": "Feature Flag Review",
  "description": "Reviews feature flag and A/B testing code for correctness and performance",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*feature*.js",
      "*feature*.ts",
      "*flag*.js",
      "*flag*.ts",
      "*experiment*.js",
      "*experiment*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Feature flag code was modified. Analyze for: 1) Consistent user bucketing across sessions, 2) Performance impact of flag evaluation, 3) Default values for flag failures, 4) Cleanup of old/unused flags, 5) Analytics tracking for experiments, 6) Gradual rollout strategies, 7) Emergency kill switch capability. Suggest improvements."
  }
}