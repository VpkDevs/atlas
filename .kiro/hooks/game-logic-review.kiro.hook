{
  "enabled": true,
  "name": "Game Logic Review",
  "description": "Reviews game logic code for fairness and performance",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*game*.js",
      "*game*.ts",
      "*player*.js",
      "*physics*.js",
      "*collision*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Game logic code was modified. Check for: 1) Deterministic behavior for multiplayer, 2) Cheat prevention (server-side validation), 3) Frame rate independence, 4) State synchronization, 5) Physics performance optimization, 6) Random number generation fairness, 7) Lag compensation. Suggest improvements."
  }
}