{
  "enabled": true,
  "name": "GraphQL Schema Review",
  "description": "Analyzes GraphQL schema changes for breaking changes, deprecation strategies, and best practices",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.graphql",
      "*.gql",
      "schema.*.ts",
      "schema.*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A GraphQL schema was modified. Review for: 1) Breaking changes (removed fields, changed types), 2) Proper use of deprecation directives, 3) Nullable vs non-nullable field decisions, 4) N+1 query risks and DataLoader usage, 5) Input validation and error handling, 6) Documentation strings for all types and fields. Suggest migration strategies for breaking changes."
  }
}