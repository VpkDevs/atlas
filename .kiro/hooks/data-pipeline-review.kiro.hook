{
  "enabled": true,
  "name": "Data Pipeline Review",
  "description": "Analyzes data transformation and ETL code for correctness",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*transform*.js",
      "*transform*.ts",
      "*etl*.js",
      "*etl*.py",
      "*pipeline*.js",
      "*pipeline*.py"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Data transformation code was modified. Review for: 1) Data validation at each stage, 2) Error handling and dead letter queues, 3) Idempotency for reprocessing, 4) Memory efficiency for large datasets, 5) Data quality checks, 6) Monitoring and observability, 7) Backfill and replay strategies. Suggest improvements."
  }
}