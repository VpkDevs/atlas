{
  "enabled": true,
  "name": "Rate Limit Review",
  "description": "Analyzes rate limiting and throttling implementations for effectiveness",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*ratelimit*.js",
      "*ratelimit*.ts",
      "*throttle*.js",
      "*throttle*.ts",
      "*limiter*.js",
      "*limiter*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Rate limiting code was modified. Review for: 1) Appropriate limits per endpoint/user tier, 2) Distributed rate limiting (Redis, etc.), 3) Clear rate limit headers (X-RateLimit-*), 4) Graceful degradation vs hard blocks, 5) Bypass for internal services, 6) DDoS protection strategies, 7) User feedback on limits. Suggest improvements."
  }
}