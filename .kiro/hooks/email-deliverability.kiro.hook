{
  "enabled": true,
  "name": "Email Deliverability",
  "description": "Reviews email sending code for deliverability, security, and best practices",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*email*.js",
      "*email*.ts",
      "*mailer*.js",
      "*mailer*.ts",
      "*notification*.js",
      "*notification*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Email code was modified. Check for: 1) SPF, DKIM, DMARC configuration, 2) Unsubscribe links and compliance (CAN-SPAM, GDPR), 3) Rate limiting to avoid spam flags, 4) HTML email accessibility and fallbacks, 5) Bounce and complaint handling, 6) Template injection vulnerabilities, 7) Personalization without exposing PII. Suggest improvements."
  }
}