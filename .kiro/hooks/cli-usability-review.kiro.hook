{
  "enabled": true,
  "name": "CLI Usability Review",
  "description": "Reviews CLI tool code for usability and error handling",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*cli*.js",
      "*cli*.ts",
      "*command*.js",
      "*command*.ts",
      "bin/*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "CLI code was modified. Check for: 1) Clear help text and examples, 2) Input validation and error messages, 3) Progress indicators for long operations, 4) Confirmation prompts for destructive actions, 5) Exit codes for scripting, 6) Configuration file support, 7) Colored output and formatting. Suggest UX improvements."
  }
}