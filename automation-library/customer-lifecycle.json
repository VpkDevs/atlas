{
  "name": "Customer Lifecycle Management",
  "description": "End-to-end customer journey automation from signup to retention",
  "nodes": [
    {
      "name": "New Signup Trigger",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300],
      "parameters": {
        "path": "customer-signup",
        "responseMode": "responseNode"
      }
    },
    {
      "name": "Extract Customer Data",
      "type": "n8n-nodes-base.function",
      "position": [450, 300],
      "parameters": {
        "functionCode": "const data = $input.first().json;\nreturn [{\n  json: {\n    customer_id: data.customer_id,\n    email: data.email,\n    name: data.name,\n    plan: data.plan || 'free',\n    signup_date: new Date().toISOString(),\n    source: data.source || 'organic',\n    lifecycle_stage: 'onboarding'\n  }\n}];"
      }
    },
    {
      "name": "Store in Database",
      "type": "n8n-nodes-base.postgres",
      "position": [650, 300],
      "parameters": {
        "operation": "insert",
        "table": "customers",
        "columns": "customer_id,email,name,plan,signup_date,source,lifecycle_stage",
        "values": "={{$json.customer_id}},={{$json.email}},={{$json.name}},={{$json.plan}},={{$json.signup_date}},={{$json.source}},={{$json.lifecycle_stage}}"
      }
    },
    {
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.emailSend",
      "position": [850, 200],
      "parameters": {
        "fromEmail": "welcome@[PRODUCT_NAME].com",
        "toEmail": "={{$json.email}}",
        "subject": "Welcome to [PRODUCT_NAME]! 🎉",
        "html": "<h1>Welcome {{$json.name}}!</h1><p>We're excited to have you on board.</p><p><a href='[ONBOARDING_LINK]'>Start your journey</a></p>"
      }
    },
    {
      "name": "Create Onboarding Task",
      "type": "n8n-nodes-base.linear",
      "position": [850, 400],
      "parameters": {
        "resource": "issue",
        "operation": "create",
        "teamId": "=[LINEAR_TEAM_ID]",
        "title": "Onboard: {{$json.name}} ({{$json.email}})",
        "description": "New customer signup\nPlan: {{$json.plan}}\nSource: {{$json.source}}"
      }
    },
    {
      "name": "Schedule Follow-up",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [1050, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "minutesInterval": 1440
            }
          ]
        }
      }
    },
    {
      "name": "Check Activation Status",
      "type": "n8n-nodes-base.postgres",
      "position": [1250, 300],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM customers WHERE customer_id = '={{$json.customer_id}}' AND last_activity > NOW() - INTERVAL '24 hours'"
      }
    },
    {
      "name": "Activation Decision",
      "type": "n8n-nodes-base.if",
      "position": [1450, 300],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.rows.length}}",
              "operation": "equals",
              "value2": "0"
            }
          ]
        }
      }
    },
    {
      "name": "Send Activation Reminder",
      "type": "n8n-nodes-base.emailSend",
      "position": [1650, 200],
      "parameters": {
        "fromEmail": "support@[PRODUCT_NAME].com",
        "toEmail": "={{$json.email}}",
        "subject": "Let's get you started with [PRODUCT_NAME]",
        "html": "<h2>Hi {{$json.name}},</h2><p>We noticed you haven't started yet.</p><p><a href='[ACTIVATION_LINK]'>Complete your setup</a></p>"
      }
    },
    {
      "name": "Track Activation",
      "type": "n8n-nodes-base.postgres",
      "position": [1650, 400],
      "parameters": {
        "operation": "update",
        "table": "customers",
        "where": "customer_id = '={{$json.customer_id}}'",
        "set": "lifecycle_stage = 'activated', activated_date = NOW()"
      }
    },
    {
      "name": "Monitor Usage",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [1850, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "minutesInterval": 1440
            }
          ]
        }
      }
    },
    {
      "name": "Calculate Health Score",
      "type": "n8n-nodes-base.function",
      "position": [2050, 300],
      "parameters": {
        "functionCode": "const stripe = require('stripe')(process.env.STRIPE_SECRET_KEY);\nconst customerId = $input.first().json.customer_id;\n\n// Get subscription data\nconst subscription = await stripe.subscriptions.list({\n  customer: customerId,\n  limit: 1\n});\n\nconst sub = subscription.data[0];\nlet healthScore = 50; // Base score\n\n// Factors\nif (sub && sub.status === 'active') healthScore += 20;\nif (sub && sub.items.data[0].price.recurring.interval === 'year') healthScore += 15;\nif (sub && sub.discount) healthScore += 10;\n\n// Usage-based adjustments (would integrate with your analytics)\nconst usage = await getCustomerUsage(customerId);\nif (usage > 1000) healthScore += 15;\nif (usage > 5000) healthScore += 10;\n\nreturn [{\n  json: {\n    ...sub,\n    health_score: Math.min(100, healthScore),\n    usage,\n    risk_level: healthScore < 40 ? 'high' : healthScore < 70 ? 'medium' : 'low'\n  }\n}];"
      }
    },
    {
      "name": "Churn Risk Assessment",
      "type": "n8n-nodes-base.if",
      "position": [2250, 300],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.health_score}}",
              "operation": "smaller",
              "value2": "40"
            }
          ]
        }
      }
    },
    {
      "name": "Send Retention Email",
      "type": "n8n-nodes-base.emailSend",
      "position": [2450, 200],
      "parameters": {
        "fromEmail": "support@[PRODUCT_NAME].com",
        "toEmail": "={{$json.email}}",
        "subject": "We want to help you succeed with [PRODUCT_NAME]",
        "html": "<h2>Hi {{$json.name}},</h2><p>We noticed you might need some help.</p><p><a href='[SUPPORT_LINK]'>Get support</a> or <a href='[FEEDBACK_LINK]'>share feedback</a></p>"
      }
    },
    {
      "name": "Create Support Ticket",
      "type": "n8n-nodes-base.linear",
      "position": [2450, 400],
      "parameters": {
        "resource": "issue",
        "operation": "create",
        "teamId": "=[LINEAR_TEAM_ID]",
        "title": "At-risk customer: {{$json.name}}",
        "description": "Health score: {{$json.health_score}}\nRisk level: {{$json.risk_level}}\nUsage: {{$json.usage}}\n\nNeeds proactive outreach"
      }
    },
    {
      "name": "Update Lifecycle Stage",
      "type": "n8n-nodes-base.postgres",
      "position": [2650, 300],
      "parameters": {
        "operation": "update",
        "table": "customers",
        "where": "customer_id = '={{$json.customer_id}}'",
        "set": "lifecycle_stage = CASE WHEN {{$json.health_score}} < 40 THEN 'at_risk' WHEN {{$json.health_score}} < 70 THEN 'engaged' ELSE 'thriving' END, health_score = {{$json.health_score}}, last_health_check = NOW()"
      }
    },
    {
      "name": "Log to Analytics",
      "type": "n8n-nodes-base.posthog",
      "position": [2850, 300],
      "parameters": {
        "operation": "captureEvent",
        "distinctId": "={{$json.customer_id}}",
        "event": "customer_health_check",
        "properties": {
          "health_score": "={{$json.health_score}}",
          "risk_level": "={{$json.risk_level}}",
          "usage": "={{$json.usage}}"
        }
      }
    }
  ],
  "connections": {
    "New Signup Trigger": {
      "main": [[{"node": "Extract Customer Data", "type": "main", "index": 0}]]
    },
    "Extract Customer Data": {
      "main": [[{"node": "Store in Database", "type": "main", "index": 0}]]
    },
    "Store in Database": {
      "main": [
        [{"node": "Send Welcome Email", "type": "main", "index": 0}],
        [{"node": "Create Onboarding Task", "type": "main", "index": 0}]
      ]
    },
    "Send Welcome Email": {
      "main": [[{"node": "Schedule Follow-up", "type": "main", "index": 0}]]
    },
    "Create Onboarding Task": {
      "main": [[{"node": "Schedule Follow-up", "type": "main", "index": 0}]]
    },
    "Schedule Follow-up": {
      "main": [[{"node": "Check Activation Status", "type": "main", "index": 0}]]
    },
    "Check Activation Status": {
      "main": [[{"node": "Activation Decision", "type": "main", "index": 0}]]
    },
    "Activation Decision": {
      "main": [
        [{"node": "Send Activation Reminder", "type": "main", "index": 0}],
        [{"node": "Track Activation", "type": "main", "index": 0}]
      ]
    },
    "Send Activation Reminder": {
      "main": [[{"node": "Monitor Usage", "type": "main", "index": 0}]]
    },
    "Track Activation": {
      "main": [[{"node": "Monitor Usage", "type": "main", "index": 0}]]
    },
    "Monitor Usage": {
      "main": [[{"node": "Calculate Health Score", "type": "main", "index": 0}]]
    },
    "Calculate Health Score": {
      "main": [[{"node": "Churn Risk Assessment", "type": "main", "index": 0}]]
    },
    "Churn Risk Assessment": {
      "main": [
        [{"node": "Send Retention Email", "type": "main", "index": 0}],
        [{"node": "Update Lifecycle Stage", "type": "main", "index": 0}]
      ]
    },
    "Send Retention Email": {
      "main": [[{"node": "Create Support Ticket", "type": "main", "index": 0}]]
    },
    "Create Support Ticket": {
      "main": [[{"node": "Update Lifecycle Stage", "type": "main", "index": 0}]]
    },
    "Update Lifecycle Stage": {
      "main": [[{"node": "Log to Analytics", "type": "main", "index": 0}]]
    }
  }
}