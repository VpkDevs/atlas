{
  "name": "Content Automation Engine",
  "nodes": [
    {
      "name": "Content Calendar Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [250, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "minutesInterval": 1440
            }
          ]
        }
      }
    },
    {
      "name": "Read Content Calendar",
      "type": "n8n-nodes-base.googleSheets",
      "position": [450, 300],
      "parameters": {
        "operation": "read",
        "sheetId": "=[GOOGLE_SHEET_ID]",
        "range": "A2:F100",
        "credentials": {
          "id": "googleSheets",
          "name": "Google Sheets"
        }
      }
    },
    {
      "name": "Filter Today's Content",
      "type": "n8n-nodes-base.filter",
      "position": [650, 300],
      "parameters": {
        "conditions": {
          "dateTime": [
            {
              "value1": "={{$json.date}}",
              "operation": "equals",
              "value2": "={{new Date().toISOString().split('T')[0]}}"
            }
          ]
        }
      }
    },
    {
      "name": "Generate Content with AI",
      "type": "n8n-nodes-base.openAi",
      "position": [850, 300],
      "parameters": {
        "resource": "chat",
        "operation": "create",
        "model": "gpt-4",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a professional content creator for [PRODUCT_NAME]. Create engaging, valuable content that helps our audience solve problems. Tone: helpful, expert, conversational."
            },
            {
              "role": "user",
              "content": "Create content for:\nTopic: {{$json.topic}}\nFormat: {{$json.format}}\nTarget audience: {{$json.audience}}\nKey points: {{$json.key_points}}\nCall to action: {{$json.cta}}\n\nOutput in {{$json.format}} format."
            }
          ]
        },
        "options": {
          "temperature": 0.7,
          "maxTokens": 2000
        },
        "credentials": {
          "id": "openAi",
          "name": "OpenAI"
        }
      }
    },
    {
      "name": "Format for Platform",
      "type": "n8n-nodes-base.switch",
      "position": [1050, 300],
      "parameters": {
        "rules": {
          "rules": [
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{$json.platform}}",
                    "operation": "equals",
                    "value2": "twitter"
                  }
                ]
              },
              "output": "Twitter"
            },
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{$json.platform}}",
                    "operation": "equals",
                    "value2": "linkedin"
                  }
                ]
              },
              "output": "LinkedIn"
            },
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{$json.platform}}",
                    "operation": "equals",
                    "value2": "blog"
                  }
                ]
              },
              "output": "Blog"
            },
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{$json.platform}}",
                    "operation": "equals",
                    "value2": "newsletter"
                  }
                ]
              },
              "output": "Newsletter"
            }
          ]
        }
      }
    },
    {
      "name": "Format Twitter Thread",
      "type": "n8n-nodes-base.function",
      "position": [1250, 100],
      "parameters": {
        "functionCode": "const content = $input.first().json.ai_response;\nconst topic = $input.first().json.topic;\n\n// Split content into tweet-sized chunks\nconst sentences = content.split('. ');\nconst tweets = [];\nlet currentTweet = '';\n\nfor (const sentence of sentences) {\n  if ((currentTweet + sentence + '. ').length <= 280) {\n    currentTweet += sentence + '. ';\n  } else {\n    if (currentTweet) tweets.push(currentTweet.trim());\n    currentTweet = sentence + '. ';\n  }\n}\nif (currentTweet) tweets.push(currentTweet.trim());\n\n// Add thread indicators\nconst formattedTweets = tweets.map((tweet, i) => {\n  const indicator = tweets.length > 1 ? `(${i + 1}/${tweets.length}) ` : '';\n  return indicator + tweet;\n});\n\n// Add hashtags\nconst hashtags = `#${topic.replace(/\\s+/g, '')} #[PRODUCT_NAME] #tech`;\nformattedTweets[formattedTweets.length - 1] += `\\n\\n${hashtags}`;\n\nreturn [{json: {...$input.first().json, formatted_content: formattedTweets, platform: 'twitter'}}];"
      }
    },
    {
      "name": "Format LinkedIn Post",
      "type": "n8n-nodes-base.function",
      "position": [1250, 300],
      "parameters": {
        "functionCode": "const content = $input.first().json.ai_response;\nconst topic = $input.first().json.topic;\n\n// LinkedIn formatting\nconst formatted = `🎯 ${topic}\\n\\n${content}\\n\\n---\\n\\nWhat's your take on this? I'd love to hear your thoughts in the comments.\\n\\n#${topic.replace(/\\s+/g, '')} #[PRODUCT_NAME] #business #technology`;\n\nreturn [{json: {...$input.first().json, formatted_content: [formatted], platform: 'linkedin'}}];"
      }
    },
    {
      "name": "Format Blog Post",
      "type": "n8n-nodes-base.function",
      "position": [1250, 500],
      "parameters": {
        "functionCode": "const content = $input.first().json.ai_response;\nconst topic = $input.first().json.topic;\nconst keyPoints = $input.first().json.key_points;\n\n// Blog post formatting\nconst formatted = `# ${topic}\\n\\n${content}\\n\\n## Key Takeaways\\n\\n${keyPoints.split(',').map(kp => `• ${kp.trim()}`).join('\\n')}\\n\\n## Conclusion\\n\\n${$input.first().json.cta || 'Learn more at [PRODUCT_URL]'}\\n\\n---\\n\\n*Published on ${new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}*`;\n\nreturn [{json: {...$input.first().json, formatted_content: [formatted], platform: 'blog'}}];"
      }
    },
    {
      "name": "Format Newsletter",
      "type": "n8n-nodes-base.function",
      "position": [1250, 700],
      "parameters": {
        "functionCode": "const content = $input.first().json.ai_response;\nconst topic = $input.first().json.topic;\n\n// Newsletter formatting\nconst formatted = `<!DOCTYPE html>\n<html>\n<head>\n    <style>\n        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n        .container { max-width: 600px; margin: 0 auto; padding: 20px; }\n        .header { background: #f8f9fa; padding: 20px; border-radius: 5px; }\n        .content { padding: 20px 0; }\n        .cta { background: #007bff; color: white; padding: 15px; text-align: center; border-radius: 5px; margin: 20px 0; }\n        .footer { color: #666; font-size: 12px; padding-top: 20px; border-top: 1px solid #eee; }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"header\">\n            <h1>${topic}</h1>\n            <p>Your weekly update from [PRODUCT_NAME]</p>\n        </div>\n        <div class=\"content\">\n            ${content.replace(/\\n/g, '</p><p>')}\n        </div>\n        <div class=\"cta\">\n            <a href=\"[PRODUCT_URL]\" style=\"color: white; text-decoration: none;\">${$input.first().json.cta || 'Learn More'}</a>\n        </div>\n        <div class=\"footer\">\n            <p>© ${new Date().getFullYear()} [PRODUCT_NAME]. All rights reserved.</p>\n            <p><a href=\"[UNSUBSCRIBE_LINK]\">Unsubscribe</a></p>\n        </div>\n    </div>\n</body>\n</html>`;\n\nreturn [{json: {...$input.first().json, formatted_content: [formatted], platform: 'newsletter', is_html: true}}];"
      }
    },
    {
      "name": "Schedule Twitter Post",
      "type": "n8n-nodes-base.twitter",
      "position": [1450, 100],
      "parameters": {
        "resource": "tweet",
        "operation": "create",
        "text": "={{$json.formatted_content[0]}}",
        "additionalFields": {
          "possibly_sensitive": false
        },
        "credentials": {
          "id": "twitter",
          "name": "Twitter"
        }
      }
    },
    {
      "name": "Schedule LinkedIn Post",
      "type": "n8n-nodes-base.linkedIn",
      "position": [1450, 300],
      "parameters": {
        "operation": "createPost",
        "text": "={{$json.formatted_content[0]}}",
        "visibility": "PUBLIC",
        "credentials": {
          "id": "linkedIn",
          "name": "LinkedIn"
        }
      }
    },
    {
      "name": "Publish Blog Post",
      "type": "n8n-nodes-base.wordpress",
      "position": [1450, 500],
      "parameters": {
        "operation": "create",
        "title": "={{$json.topic}}",
        "content": "={{$json.formatted_content[0]}}",
        "status": "publish",
        "additionalFields": {
          "categories": "=[BLOG_CATEGORY_ID]"
        },
        "credentials": {
          "id": "wordpress",
          "name": "WordPress"
        }
      }
    },
    {
      "name": "Send Newsletter",
      "type": "n8n-nodes-base.emailSend",
      "position": [1450, 700],
      "parameters": {
        "fromEmail": "newsletter@[PRODUCT_NAME].com",
        "toEmail": "=[NEWSLETTER_LIST_ID]",
        "subject": "={{$json.topic}} - [PRODUCT_NAME] Weekly",
        "html": "={{$json.formatted_content[0]}}",
        "credentials": {
          "id": "resend",
          "name": "Resend"
        }
      }
    },
    {
      "name": "Log Publication",
      "type": "n8n-nodes-base.postgres",
      "position": [1650, 300],
      "parameters": {
        "operation": "insert",
        "table": "content_publications",
        "columns": "topic,platform,content_hash,published_at,status",
        "values": "={{$json.topic}},={{$json.platform}},=md5({{$json.formatted_content[0]}}),={{new Date().toISOString()}},='scheduled'",
        "credentials": {
          "id": "postgres",
          "name": "PostgreSQL"
        }
      }
    },
    {
      "name": "Analytics Tracking",
      "type": "n8n-nodes-base.googleAnalytics",
      "position": [1850, 300],
      "parameters": {
        "operation": "createEvent",
        "eventCategory": "content",
        "eventAction": "published",
        "eventLabel": "={{$json.platform}}",
        "eventValue": "1",
        "credentials": {
          "id": "googleAnalytics",
          "name": "Google Analytics"
        }
      }
    },
    {
      "name": "Slack Notification",
      "type": "n8n-nodes-base.slack",
      "position": [2050, 300],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": "#content-alerts",
        "text": "📝 Content published\\n• Topic: {{$json.topic}}\\n• Platform: {{$json.platform}}\\n• Status: Scheduled\\n• Time: {{new Date().toLocaleTimeString()}}",
        "credentials": {
          "id": "slack",
          "name": "Slack"
        }
      }
    },
    {
      "name": "Update Calendar Status",
      "type": "n8n-nodes-base.googleSheets",
      "position": [2250, 300],
      "parameters": {
        "operation": "update",
        "sheetId": "=[GOOGLE_SHEET_ID]",
        "range": "={{$json.row}}",
        "fields": {
          "values": [
            {
              "status": "published",
              "published_at": "={{new Date().toISOString()}}"
            }
          ]
        },
        "credentials": {
          "id": "googleSheets",
          "name": "Google Sheets"
        }
      }
    }
  ],
