{
  "enabled": true,
  "name": "File Upload Security",
  "description": "Analyzes file upload handling for security vulnerabilities and resource management",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*upload*.js",
      "*upload*.ts",
      "*file*.js",
      "*file*.ts",
      "*storage*.js",
      "*storage*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "File upload code was modified. Review for: 1) File type validation (magic bytes, not just extension), 2) File size limits and quota enforcement, 3) Virus/malware scanning, 4) Path traversal vulnerabilities, 5) Secure file naming (no user input in paths), 6) Storage location security (not in web root), 7) Cleanup of temporary files. Flag security risks."
  }
}