{
  "enabled": true,
  "name": "Recommendation Review",
  "description": "Analyzes recommendation engine and personalization code",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*recommend*.js",
      "*recommend*.ts",
      "*recommend*.py",
      "*personalization*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Recommendation code was modified. Review for: 1) Cold start problem handling, 2) Diversity and serendipity, 3) Filter bubble prevention, 4) Real-time vs batch processing, 5) A/B testing framework, 6) Explainability of recommendations, 7) Performance at scale. Suggest improvements."
  }
}