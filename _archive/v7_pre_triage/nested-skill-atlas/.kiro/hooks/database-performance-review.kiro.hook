{
  "enabled": true,
  "name": "Database Performance Review",
  "description": "Reviews database-related operations for performance issues, N+1 queries, missing indexes, and optimization opportunities",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      ".*sql.*|.*database.*|.*query.*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Before executing this database operation, review for: 1) N+1 query problems, 2) Missing indexes on frequently queried columns, 3) Inefficient joins or subqueries, 4) Opportunities for query optimization or caching, 5) Proper use of transactions and connection pooling. Suggest improvements if needed."
  }
}