{
  "enabled": true,
  "name": "Audit Logging Review",
  "description": "Analyzes audit logging and compliance tracking",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*audit*.js",
      "*audit*.ts",
      "*audit*.py",
      "*compliance*.js",
      "*compliance*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Audit logging code was modified. Review for: 1) Comprehensive event coverage (who, what, when, where), 2) Tamper-proof log storage, 3) Retention policies and archival, 4) PII handling in logs, 5) Log integrity verification, 6) Compliance requirements (SOC2, HIPAA), 7) Search and reporting capabilities. Suggest compliance improvements."
  }
}