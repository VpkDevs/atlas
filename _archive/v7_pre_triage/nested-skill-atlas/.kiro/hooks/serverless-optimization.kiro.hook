{
  "enabled": true,
  "name": "Serverless Optimization",
  "description": "Analyzes serverless function code for cold start and cost optimization",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*lambda*.js",
      "*lambda*.ts",
      "*lambda*.py",
      "*function*.js",
      "serverless.yml"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Serverless function code was modified. Review for: 1) Cold start optimization (connection pooling, lazy loading), 2) Memory and timeout configuration, 3) Cost optimization (execution time), 4) Concurrent execution limits, 5) Error handling and retries, 6) Environment variable usage, 7) VPC configuration impact. Suggest optimizations."
  }
}