{
  "enabled": true,
  "name": "Geolocation Review",
  "description": "Analyzes geolocation and mapping code",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*geo*.js",
      "*geo*.ts",
      "*location*.js",
      "*location*.ts",
      "*map*.js",
      "*map*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Geolocation code was modified. Review for: 1) User permission handling, 2) Fallback for denied permissions, 3) Accuracy vs battery tradeoff, 4) Geocoding rate limits, 5) Privacy considerations (data retention), 6) Offline map support, 7) Distance calculation accuracy. Suggest improvements."
  }
}