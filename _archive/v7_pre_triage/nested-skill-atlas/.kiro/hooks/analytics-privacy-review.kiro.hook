{
  "enabled": true,
  "name": "Analytics Privacy Review",
  "description": "Reviews analytics and tracking code for privacy and accuracy",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*analytics*.js",
      "*analytics*.ts",
      "*tracking*.js",
      "*tracking*.ts",
      "*telemetry*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Analytics code was modified. Check for: 1) User consent before tracking, 2) PII anonymization, 3) Event naming consistency, 4) Sampling for high-volume events, 5) Client-side vs server-side tracking, 6) Ad blocker resilience, 7) Data retention policies. Suggest privacy and accuracy improvements."
  }
}