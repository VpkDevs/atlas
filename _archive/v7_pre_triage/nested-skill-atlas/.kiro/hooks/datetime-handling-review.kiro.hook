{
  "enabled": true,
  "name": "DateTime Handling Review",
  "description": "Reviews time and date handling code for correctness",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*datetime*.js",
      "*datetime*.ts",
      "*time*.js",
      "*timezone*.js",
      "*moment*.js",
      "*dayjs*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Date/time code was modified. Check for: 1) Timezone handling and UTC storage, 2) Daylight saving time transitions, 3) Leap year and leap second handling, 4) Date parsing and formatting, 5) Relative time calculations, 6) Locale-specific formatting, 7) Library choice (avoid moment.js). Suggest correctness improvements."
  }
}