{
  "enabled": true,
  "name": "State Management Review",
  "description": "Reviews state management code for correctness and performance",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*store*.js",
      "*store*.ts",
      "*redux*.js",
      "*zustand*.js",
      "*state*.js",
      "*state*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "State management code was modified. Check for: 1) Immutable state updates, 2) Normalized state structure, 3) Selector memoization, 4) Action naming conventions, 5) Side effect handling, 6) State persistence strategy, 7) DevTools integration. Suggest performance and maintainability improvements."
  }
}