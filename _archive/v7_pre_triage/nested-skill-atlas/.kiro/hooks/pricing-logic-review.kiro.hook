{
  "enabled": true,
  "name": "Pricing Logic Review",
  "description": "Reviews competitive pricing and dynamic pricing logic",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*pricing*.js",
      "*pricing*.ts",
      "*price*.js",
      "*discount*.js",
      "*coupon*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Pricing logic code was modified. Review for: 1) Rounding and precision handling, 2) Currency conversion accuracy, 3) Discount stacking rules, 4) Price discrimination legality, 5) Tax calculation correctness, 6) Price history and auditing, 7) A/B testing of prices. Flag calculation errors."
  }
}