{
  "enabled": true,
  "name": "Changelog Quality",
  "description": "Reviews changelog entries for clarity and completeness",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "changelog.md",
      "HISTORY.md",
      "RELEASES.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Changelog was modified. Check for: 1) Clear categorization (Added, Changed, Fixed, Deprecated, Removed, Security), 2) User-facing language (not technical jargon), 3) Breaking changes highlighted, 4) Version numbers and dates, 5) Links to issues/PRs, 6) Migration instructions for breaking changes. Suggest improvements for clarity."
  }
}