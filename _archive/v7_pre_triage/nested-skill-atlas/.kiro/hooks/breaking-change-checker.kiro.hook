{
  "enabled": true,
  "name": "Breaking Change Checker",
  "description": "Checks for breaking changes and API compatibility issues before tasks begin execution",
  "version": "1",
  "when": {
    "type": "preTaskExecution"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Before starting this task, analyze if the planned changes could introduce breaking changes to: 1) Public APIs or interfaces, 2) Database schemas, 3) Configuration formats, 4) Dependencies or contracts with other services. If breaking changes are likely, suggest migration strategies or backward compatibility approaches."
  }
}