{
  "enabled": true,
  "name": "Inventory Management Review",
  "description": "Analyzes inventory and stock management code",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*inventory*.js",
      "*inventory*.ts",
      "*stock*.js",
      "*stock*.ts",
      "*warehouse*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Inventory management code was modified. Review for: 1) Race conditions in stock updates, 2) Overselling prevention, 3) Reservation and hold logic, 4) Stock reconciliation, 5) Multi-location inventory, 6) Backorder handling, 7) Audit trail for stock changes. Flag concurrency issues."
  }
}