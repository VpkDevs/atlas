{
  "enabled": true,
  "name": "Cache Strategy Review",
  "description": "Analyzes caching strategies for correctness, invalidation, and performance",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*cache*.js",
      "*cache*.ts",
      "*redis*.js",
      "*redis*.ts",
      "*memcache*.js",
      "*memcache*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Caching code was modified. Review for: 1) Cache invalidation strategy (TTL, manual, event-based), 2) Cache key naming and collision risks, 3) Stale data handling, 4) Cache stampede prevention, 5) Memory limits and eviction policies, 6) Serialization efficiency, 7) Cache warming strategies. Suggest improvements for correctness and performance."
  }
}