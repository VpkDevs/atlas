{
  "enabled": true,
  "name": "Pagination Review",
  "description": "Reviews pagination implementation for performance and user experience",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*pagination*.js",
      "*pagination*.ts",
      "*paging*.js",
      "*paging*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Pagination code was modified. Check for: 1) Cursor-based vs offset pagination tradeoffs, 2) Consistent ordering for stable pages, 3) Total count performance impact, 4) Page size limits and defaults, 5) Deep pagination performance, 6) Next/previous page metadata, 7) Infinite scroll considerations. Suggest improvements for scale."
  }
}