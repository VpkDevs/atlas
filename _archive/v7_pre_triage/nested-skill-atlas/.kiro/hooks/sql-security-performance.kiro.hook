{
  "enabled": true,
  "name": "SQL Security & Performance",
  "description": "Analyzes SQL queries for injection vulnerabilities, performance issues, and best practices",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.sql",
      "*query*.js",
      "*query*.ts",
      "*repository*.js",
      "*repository*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "SQL code was modified. Analyze for: 1) SQL injection vulnerabilities (use parameterized queries), 2) Missing indexes on WHERE/JOIN columns, 3) SELECT * instead of specific columns, 4) N+1 query patterns, 5) Missing LIMIT clauses, 6) Inefficient subqueries vs JOINs, 7) Transaction boundaries. Flag security risks and suggest optimizations."
  }
}