{
  "enabled": true,
  "name": "Background Job Reliability",
  "description": "Analyzes background job and queue processing code for reliability and error handling",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*job*.js",
      "*job*.ts",
      "*worker*.js",
      "*worker*.ts",
      "*queue*.js",
      "*queue*.ts",
      "*celery*.py"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Background job code was modified. Review for: 1) Idempotency for retry safety, 2) Timeout and memory limits, 3) Dead letter queue for failed jobs, 4) Job priority and scheduling, 5) Progress tracking and cancellation, 6) Graceful shutdown handling, 7) Monitoring and alerting on failures. Suggest reliability improvements."
  }
}