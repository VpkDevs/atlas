{
  "enabled": true,
  "name": "Lint New Files",
  "description": "Runs linting and formatting checks when source files are created to ensure they follow project standards from the start",
  "version": "1",
  "when": {
    "type": "fileCreated",
    "patterns": [
      "*.js",
      "*.ts",
      "*.jsx",
      "*.tsx",
      "*.py",
      "*.java",
      "*.go",
      "*.rs"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npm run lint"
  }
}