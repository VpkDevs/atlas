{
  "enabled": true,
  "name": "Resilience Pattern Review",
  "description": "Analyzes retry logic and circuit breaker patterns",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*retry*.js",
      "*retry*.ts",
      "*circuit*.js",
      "*circuit*.ts",
      "*breaker*.js",
      "*breaker*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Resilience pattern code was modified. Review for: 1) Exponential backoff with jitter, 2) Maximum retry limits, 3) Idempotency of retried operations, 4) Circuit breaker thresholds, 5) Fallback strategies, 6) Timeout configuration, 7) Monitoring and alerting on failures. Suggest reliability improvements."
  }
}