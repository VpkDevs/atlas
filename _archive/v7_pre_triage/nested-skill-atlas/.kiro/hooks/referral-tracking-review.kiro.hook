{
  "enabled": true,
  "name": "Referral Tracking Review",
  "description": "Analyzes referral and affiliate tracking code",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*referral*.js",
      "*referral*.ts",
      "*affiliate*.js",
      "*affiliate*.ts",
      "*commission*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Referral tracking code was modified. Review for: 1) Attribution accuracy (first-touch, last-touch, multi-touch), 2) Cookie and tracking persistence, 3) Fraud prevention, 4) Commission calculation correctness, 5) Payout tracking and reconciliation, 6) Cross-device tracking, 7) Privacy compliance. Suggest improvements."
  }
}