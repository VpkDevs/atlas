{
  "enabled": true,
  "name": "Webhook Security",
  "description": "Analyzes webhook handling code for security and reliability",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*webhook*.js",
      "*webhook*.ts",
      "*callback*.js",
      "*callback*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Webhook code was modified. Review for: 1) Signature verification (HMAC), 2) Replay attack prevention (timestamp checks), 3) Idempotency handling, 4) Timeout and retry logic, 5) Async processing (don't block webhook response), 6) IP allowlisting if applicable, 7) Logging for debugging. Flag security issues."
  }
}