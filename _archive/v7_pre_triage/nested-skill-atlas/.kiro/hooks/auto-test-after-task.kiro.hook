{
  "enabled": true,
  "name": "Auto Test After Task",
  "description": "Automatically runs tests after completing a task to ensure the implementation works correctly and doesn't break existing functionality",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "npm test"
  }
}