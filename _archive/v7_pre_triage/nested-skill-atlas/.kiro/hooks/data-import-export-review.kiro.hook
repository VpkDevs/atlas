{
  "enabled": true,
  "name": "Data Import/Export Review",
  "description": "Analyzes data import and export functionality",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*import*.js",
      "*import*.ts",
      "*importer*.js",
      "*exporter*.js",
      "*bulk*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Data import/export code was modified. Review for: 1) File format validation, 2) Large file handling (streaming), 3) Error reporting and partial success, 4) Data validation and transformation, 5) Duplicate detection, 6) Progress tracking, 7) Rollback on failure. Suggest reliability improvements."
  }
}