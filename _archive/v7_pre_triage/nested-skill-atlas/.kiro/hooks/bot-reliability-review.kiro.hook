{
  "enabled": true,
  "name": "Bot Reliability Review",
  "description": "Analyzes bot and automation code for reliability",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*bot*.js",
      "*bot*.ts",
      "*bot*.py",
      "*automation*.js",
      "*automation*.py"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Bot/automation code was modified. Review for: 1) Rate limiting to avoid API bans, 2) Error recovery and retry logic, 3) State persistence across restarts, 4) Graceful degradation, 5) Logging and monitoring, 6) Kill switch for emergencies, 7) Testing in sandbox environments. Suggest reliability improvements."
  }
}