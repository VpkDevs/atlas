{
  "enabled": true,
  "name": "Accessibility Review",
  "description": "Reviews accessibility implementation in UI code",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*a11y*.js",
      "*a11y*.ts",
      "*accessibility*.js",
      "*accessibility*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Accessibility code was modified. Check for: 1) ARIA labels and roles, 2) Keyboard navigation support, 3) Focus management and visible focus indicators, 4) Screen reader announcements, 5) Color contrast ratios (WCAG AA/AAA), 6) Alternative text for images, 7) Form labels and error associations. Suggest accessibility improvements."
  }
}