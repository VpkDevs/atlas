{
  "enabled": true,
  "name": "Scheduler Review",
  "description": "Analyzes scheduling and cron job configurations",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*cron*.js",
      "*cron*.ts",
      "*schedule*.js",
      "*schedule*.ts",
      "crontab"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Scheduling code was modified. Review for: 1) Timezone handling, 2) Overlap prevention (locking), 3) Failure alerting, 4) Execution history and logging, 5) Resource usage during peak times, 6) Graceful handling of missed runs, 7) Testing scheduled jobs. Suggest reliability improvements."
  }
}