{
  "enabled": true,
  "name": "Test Data Quality",
  "description": "Reviews data seeding and fixture code for test data quality",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*seed*.js",
      "*seed*.ts",
      "*fixture*.js",
      "*fixture*.ts",
      "*factory*.js",
      "*factory*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Test data/seed code was modified. Check for: 1) Realistic and diverse test data, 2) Edge cases covered (empty, null, max values), 3) No production data in seeds, 4) Idempotent seed operations, 5) Performance of large seeds, 6) Relationships and foreign keys, 7) Clear data cleanup strategy. Suggest improvements."
  }
}