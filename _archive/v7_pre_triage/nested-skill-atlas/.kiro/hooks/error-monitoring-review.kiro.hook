{
  "enabled": true,
  "name": "Error Monitoring Review",
  "description": "Reviews error handling and monitoring code for completeness and usefulness",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*error*.js",
      "*error*.ts",
      "*exception*.js",
      "*exception*.ts",
      "*monitoring*.js",
      "*monitoring*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Error handling code was modified. Check for: 1) Proper error context and stack traces, 2) User-friendly error messages vs internal details, 3) Error categorization and severity levels, 4) Retry logic for transient failures, 5) Dead letter queues for failed operations, 6) Alerting thresholds and escalation, 7) PII in error logs. Suggest improvements for debugging and monitoring."
  }
}