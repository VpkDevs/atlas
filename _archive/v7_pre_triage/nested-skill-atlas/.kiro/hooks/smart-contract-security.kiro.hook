{
  "enabled": true,
  "name": "Smart Contract Security",
  "description": "Reviews blockchain and smart contract code for security vulnerabilities",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.sol",
      "*contract*.js",
      "*contract*.ts",
      "*web3*.js",
      "*ethers*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Smart contract code was modified. Review for: 1) Reentrancy vulnerabilities, 2) Integer overflow/underflow, 3) Access control issues, 4) Gas optimization, 5) Front-running risks, 6) Oracle manipulation, 7) Upgrade patterns and immutability. Flag critical security issues."
  }
}