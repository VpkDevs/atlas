{
  "enabled": true,
  "name": "Onboarding Flow Review",
  "description": "Reviews onboarding and user activation flows",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*onboarding*.js",
      "*onboarding*.ts",
      "*tutorial*.js",
      "*wizard*.js",
      "*activation*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Onboarding flow code was modified. Check for: 1) Progressive disclosure (not overwhelming), 2) Skip and resume capability, 3) Progress indicators, 4) Contextual help and tooltips, 5) Success metrics tracking, 6) A/B testing setup, 7) Accessibility for all users. Suggest UX improvements."
  }
}