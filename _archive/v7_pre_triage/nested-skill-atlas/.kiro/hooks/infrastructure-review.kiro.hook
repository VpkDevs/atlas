{
  "enabled": true,
  "name": "Infrastructure Review",
  "description": "Reviews infrastructure-as-code for security, cost optimization, and best practices",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.tf",
      "*.tfvars",
      "cloudformation.yml",
      "cloudformation.yaml",
      "*.template",
      "pulumi/*",
      "cdk/*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Infrastructure code was modified. Analyze for: 1) Security groups and network exposure, 2) IAM permissions (least privilege principle), 3) Cost optimization (instance sizes, storage tiers), 4) Backup and disaster recovery, 5) Monitoring and alerting setup, 6) Resource tagging and organization, 7) State management and locking. Flag security risks and suggest optimizations."
  }
}