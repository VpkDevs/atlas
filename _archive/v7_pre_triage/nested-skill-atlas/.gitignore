# Atlas runtime state — never committed
# These live at ~/.atlas/ during operation, not in this repo
# But if someone tests Atlas from this directory, these patterns catch strays

# Local Atlas / agent state (e.g. score runs, reports)
.atlas-state/

# Runtime state
.atlas/
context.json
context.json.bak
credentials_index.json
mission.json
growth_log.md
incidents/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Test artifacts
test-output/
tmp/
*.tmp

# Secrets (should never be here, but just in case)
.env
.env.local
.env*.local
*.pem
*.key

# Node (scripts, scoring-engine, etc.)
node_modules/
**/node_modules/

dist/
build/
out/
.next/
.nuxt/
coverage/
.nyc_output/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm
.yarn/cache
.eslintcache

*.tsbuildinfo
.turbo/

# Vitest (if used locally)
.vitest/

# Playwright / test output
playwright-report/
test-results/

# Python (for any future tooling)
__pycache__/
*.pyc
.venv/
