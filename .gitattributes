# Atlas .gitattributes
# Normalise line endings: always store as LF in the repo, checkout as native on Windows
* text=auto eol=lf

# Force LF for all shell/markdown/JSON/JS/TS source files
*.js    text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.ps1   text eol=lf
*.html  text eol=lf
*.css   text eol=lf

# Binary files — never modify
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.zip  binary
*.pem  binary
